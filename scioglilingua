        function saveStudentData() {
            state.studentName = document.getElementById('user-fullname').value;
            state.studentClass = document.getElementById('user-class').value;
            localStorage.setItem('typing_student_name', state.studentName);
            localStorage.setItem('typing_student_class', state.studentClass);
        }

        function loadSavedStudentData() {
            const savedName = localStorage.getItem('typing_student_name');
            const savedClass = localStorage.getItem('typing_student_class');
            if (savedName) {
                state.studentName = savedName;
                document.getElementById('user-fullname').value = savedName;
            }
            if (savedClass) {
                state.studentClass = savedClass;
                document.getElementById('user-class').value = savedClass;
