<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daily Routine Typing Pro</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter & Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@500;700;800;900&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #f0fdf4 0%, #ecfeff 35%, #fdf4ff 70%, #fffbeb 100%);
            min-height: 100vh;
            overflow-x: hidden;
            color: #0f172a;
        }

        .font-display {
            font-family: 'Outfit', sans-serif;
        }

        /* Glowing background shapes */
        .bg-shape {
            position: fixed;
            border-radius: 50%;
            filter: blur(100px);
            z-index: 0;
            pointer-events: none;
            opacity: 0.55;
        }

        @keyframes floatSlow {
            0%, 100% { transform: translateY(0px) scale(1); }
            50% { transform: translateY(-15px) scale(1.05); }
        }
        .animate-float {
            animation: floatSlow 7s ease-in-out infinite;
        }

        .char-current {
            background-color: #fef08a;
            color: #1e293b;
            border-bottom: 3px solid #eab308;
            border-radius: 4px;
            box-shadow: 0 0 12px rgba(234, 179, 8, 0.6);
            animation: cursorPulse 1s infinite;
        }

        @keyframes cursorPulse {
            0%, 49% { background-color: #fef08a; }
            50%, 100% { background-color: #fde047; }
        }

        .char-correct {
            color: #059669;
            background-color: rgba(16, 185, 129, 0.12);
            border-radius: 3px;
        }

        .char-incorrect {
            color: #ffffff !important;
            background-color: #e11d48 !important;
            border-radius: 4px;
            box-shadow: 0 0 10px rgba(225, 29, 72, 0.6);
        }

        .v-key {
            transition: all 0.08s ease;
            box-shadow: 0 3px 0 #cbd5e1;
        }
        .v-key.active-target {
            background: linear-gradient(135deg, #fde047, #22d3ee) !important;
            color: #0f172a !important;
            border-color: #ca8a04 !important;
            transform: translateY(-2px) scale(1.06);
            box-shadow: 0 0 18px rgba(34, 211, 238, 0.8), 0 3px 0 #a16207;
            font-weight: 900;
        }
        .v-key.pressed {
            transform: translateY(2px);
            box-shadow: 0 1px 0 #cbd5e1;
        }

        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb {
            background: #38bdf8;
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #0ea5e9;
        }
    </style>
</head>
<body class="antialiased selection:bg-cyan-200 selection:text-slate-900" onclick="focusTypingInput()">

    <!-- Glowing Background Orbs (Bright Pastel) -->
    <div class="bg-shape w-[420px] h-[420px] bg-emerald-300 top-[-10%] left-[-5%] animate-float"></div>
    <div class="bg-shape w-[420px] h-[420px] bg-cyan-300 bottom-[-10%] right-[-5%] animate-float" style="animation-delay: 2s;"></div>
    <div class="bg-shape w-[350px] h-[350px] bg-fuchsia-300 top-[40%] left-[60%] animate-float" style="animation-delay: 4s;"></div>

    <!-- Confetti Canvas -->
    <canvas id="confetti-canvas" class="fixed inset-0 pointer-events-none z-50"></canvas>

    <!-- MAIN CONTAINER -->
    <div class="relative z-10 max-w-6xl mx-auto px-4 py-4 sm:py-6 flex flex-col min-h-screen">

        <!-- HEADER -->
        <header class="bg-white/90 backdrop-blur-xl border border-cyan-200 rounded-3xl p-4 sm:p-5 shadow-xl shadow-cyan-100 mb-5 flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-3.5">
                <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-cyan-400 via-fuchsia-400 to-yellow-300 flex items-center justify-center text-slate-900 text-2xl shadow-lg shadow-cyan-200 animate-pulse">
                    ⌨️
                </div>
                <div>
                    <h1 class="font-display font-black text-xl sm:text-2xl bg-gradient-to-r from-cyan-600 via-fuchsia-600 to-amber-600 bg-clip-text text-transparent">
                        Daily Routine Typing Pro
                    </h1>
                    <p class="text-xs sm:text-sm text-slate-600 font-medium">
                        Digitazione Veloce • <span class="text-cyan-600 font-bold">Terza Media</span>
                    </p>
                </div>
            </div>

            <!-- STUDENT INPUT FIELDS -->
            <div class="flex flex-wrap items-center gap-2.5 w-full md:w-auto justify-end" onclick="event.stopPropagation()">
                <div class="flex items-center bg-slate-50 border border-slate-200 rounded-2xl px-3 py-1.5 shadow-inner flex-1 sm:flex-none">
                    <span class="text-xs text-slate-500 font-semibold mr-2">👤 Alunno:</span>
                    <input type="text" id="user-fullname" placeholder="Nome e Cognome" 
                        class="bg-transparent text-sm font-bold text-slate-800 focus:outline-none w-36 sm:w-44 placeholder:text-slate-400 placeholder:font-normal"
                        oninput="updateStudentData()">
                </div>
                <div class="flex items-center bg-slate-50 border border-slate-200 rounded-2xl px-3 py-1.5 shadow-inner">
                    <span class="text-xs text-slate-500 font-semibold mr-2">🏫 Classe:</span>
                    <input type="text" id="user-class" placeholder="es. 3ª A" 
                        class="bg-transparent text-sm font-bold text-slate-800 focus:outline-none w-20 sm:w-24 placeholder:text-slate-400 placeholder:font-normal"
                        list="class-suggestions" oninput="updateStudentData()">
                    <datalist id="class-suggestions">
                        <option value="3ª A"></option>
                        <option value="3ª B"></option>
                        <option value="3ª C"></option>
                        <option value="3ª D"></option>
                        <option value="3ª E"></option>
                        <option value="3ª F"></option>
                    </datalist>
                </div>
                <button onclick="toggleAudio()" id="audio-toggle-btn" 
                    class="bg-fuchsia-100 hover:bg-fuchsia-200 text-fuchsia-700 border border-fuchsia-300 p-2 rounded-2xl transition font-bold text-xs flex items-center gap-1 shadow-sm cursor-pointer"
                    title="Attiva/Disattiva Suoni">
                    🔊 <span class="hidden sm:inline">Audio</span>
                </button>
            </div>
        </header>

        <!-- CONFIGURATION PANEL -->
        <section class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-5" onclick="event.stopPropagation()">
            
            <!-- Category Selector -->
            <div class="lg:col-span-2 bg-white/90 backdrop-blur-xl border border-cyan-200 rounded-3xl p-4 sm:p-5 shadow-xl shadow-cyan-100 flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <h2 class="font-display font-bold text-base sm:text-lg text-slate-800 flex items-center gap-2">
                            <span>📚</span> Tipologia di Esercizio
                        </h2>
                        <span id="active-category-badge" class="text-xs font-bold bg-cyan-100 text-cyan-800 px-3 py-1 rounded-xl border border-cyan-300">
                            Daily Routine
                        </span>
                    </div>

                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 mb-4">
                        <button onclick="setCategory('routine')" id="cat-routine" 
                            class="cat-btn text-left p-3 rounded-2xl border-2 border-cyan-400 bg-cyan-50 font-semibold text-xs sm:text-sm text-slate-800 transition shadow-sm hover:border-cyan-500 cursor-pointer">
                            🌅 Daily Routine
                        </button>
                        <button onclick="setCategory('twisters')" id="cat-twisters" 
                            class="cat-btn text-left p-3 rounded-2xl border-2 border-slate-200 bg-slate-50 font-semibold text-xs sm:text-sm text-slate-600 transition shadow-sm hover:border-cyan-400 cursor-pointer">
                            🌀 Scioglilingua
                        </button>
                        <button onclick="setCategory('chat')" id="cat-chat" 
                            class="cat-btn text-left p-3 rounded-2xl border-2 border-slate-200 bg-slate-50 font-semibold text-xs sm:text-sm text-slate-600 transition shadow-sm hover:border-cyan-400 cursor-pointer">
                            💬 Chat & Dialoghi
                        </button>
                        <button onclick="setCategory('email')" id="cat-email" 
                            class="cat-btn text-left p-3 rounded-2xl border-2 border-slate-200 bg-slate-50 font-semibold text-xs sm:text-sm text-slate-600 transition shadow-sm hover:border-cyan-400 cursor-pointer">
                            ✉️ Email & Diario
                        </button>
                        <button onclick="setCategory('custom')" id="cat-custom" 
                            class="cat-btn text-left p-3 rounded-2xl border-2 border-slate-200 bg-slate-50 font-semibold text-xs sm:text-sm text-slate-600 transition shadow-sm hover:border-cyan-400 cursor-pointer">
                            ✏️ Incolla Testo
                        </button>
                        <button onclick="setCategory('vocab')" id="cat-vocab" 
                            class="cat-btn text-left p-3 rounded-2xl border-2 border-slate-200 bg-slate-50 font-semibold text-xs sm:text-sm text-slate-600 transition shadow-sm hover:border-cyan-400 cursor-pointer">
                            📝 Mie Parole
                        </button>
                    </div>

                    <!-- Custom / Vocab Panel -->
                    <div id="dynamic-input-panel" class="hidden mb-3 bg-slate-50 border border-slate-200 rounded-2xl p-3.5 shadow-inner">
                        <div id="custom-text-box" class="hidden">
                            <h3 class="text-xs font-bold text-slate-700 mb-1.5 flex items-center justify-between">
                                <span>Inserisci o incolla il tuo testo personalizzato (in inglese):</span>
                                <span class="text-[10px] text-cyan-600 font-normal">Ideale per verifiche o brani</span>
                            </h3>
                            <input type="text" id="custom-title-input" placeholder="Titolo del brano (es. My Summer Holiday)" class="w-full mb-2 bg-white border border-slate-200 rounded-xl px-3 py-1.5 text-xs font-medium text-slate-800 focus:outline-none focus:border-cyan-400">
                            <textarea id="custom-text-input" rows="2" placeholder="Scrivi o incolla qui il testo da digitare..." class="w-full bg-white border border-slate-200 rounded-xl p-2.5 text-xs text-slate-800 focus:outline-none focus:border-cyan-400 resize-none"></textarea>
                            <div class="flex justify-end mt-1">
                                <button onclick="loadCustomText()" class="bg-cyan-500 hover:bg-cyan-600 text-white font-bold text-xs px-4 py-1.5 rounded-xl shadow-md transition cursor-pointer">
                                    Carica Brano ✨
                                </button>
                            </div>
                        </div>

                        <div id="vocab-list-box" class="hidden">
                            <div class="flex items-center justify-between mb-1.5">
                                <h3 class="text-xs font-bold text-slate-700">La Tua Lista di Parole Personale:</h3>
                                <span id="vocab-counter" class="text-[11px] font-bold text-cyan-600">0 parole</span>
                            </div>
                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 mb-2">
                                <input type="text" id="vocab-word-input" placeholder="Parola in Inglese" class="bg-white border border-slate-200 rounded-xl px-3 py-1.5 text-xs font-medium text-slate-800 focus:outline-none focus:border-cyan-400">
                                <input type="text" id="vocab-trans-input" placeholder="Traduzione Italiana" class="bg-white border border-slate-200 rounded-xl px-3 py-1.5 text-xs font-medium text-slate-800 focus:outline-none focus:border-cyan-400">
                                <button onclick="addVocabWord()" class="bg-fuchsia-500 hover:bg-fuchsia-600 text-white font-bold text-xs px-3 py-1.5 rounded-xl shadow-md transition cursor-pointer">
                                    + Aggiungi
                                </button>
                            </div>
                            <div class="flex items-center justify-between text-[11px] text-slate-500">
                                <span>Salva le parole per le tue ripetizioni.</span>
                                <button onclick="clearVocabList()" class="text-rose-500 hover:underline font-bold cursor-pointer">Svuota lista</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Difficulty Selector -->
                <div class="flex flex-wrap items-center justify-between gap-2 pt-3 border-t border-slate-100">
                    <span class="text-xs font-bold text-slate-700">⚙️ Livello:</span>
                    <div class="flex items-center gap-1.5 bg-slate-100 p-1 rounded-2xl border border-slate-200">
                        <button onclick="setDifficulty('beginner')" id="diff-beginner" 
                            class="px-3 py-1.5 rounded-xl text-xs font-bold bg-cyan-400 text-slate-900 shadow-sm transition cursor-pointer">
                            🌱 Principiante
                        </button>
                        <button onclick="setDifficulty('intermediate')" id="diff-intermediate" 
                            class="px-3 py-1.5 rounded-xl text-xs font-bold text-slate-600 hover:text-slate-900 transition cursor-pointer">
                            🌿 Intermedio
                        </button>
                        <button onclick="setDifficulty('expert')" id="diff-expert" 
                            class="px-3 py-1.5 rounded-xl text-xs font-bold text-slate-600 hover:text-slate-900 transition cursor-pointer">
                            🌳 Esperto Pro
                        </button>
                    </div>
                </div>
            </div>

            <!-- Timer & Quick Actions Panel -->
            <div class="bg-white/90 backdrop-blur-xl border border-cyan-200 rounded-3xl p-4 sm:p-5 shadow-xl shadow-cyan-100 flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-2">
                        <h2 class="font-display font-bold text-base sm:text-lg text-slate-800 flex items-center gap-2">
                            <span>⏱️</span> Timer & Durata
                        </h2>
                        <div class="flex items-center gap-1">
                            <input type="checkbox" id="auto-timer-toggle" checked onchange="toggleAutoTimer()" class="rounded text-cyan-500 focus:ring-cyan-400 w-4 h-4 cursor-pointer">
                            <label for="auto-timer-toggle" class="text-[11px] font-semibold text-slate-600 cursor-pointer">Adatta timer</label>
                        </div>
                    </div>

                    <!-- Timer Preset Buttons -->
                    <div class="grid grid-cols-4 gap-1.5 mb-3">
                        <button onclick="setTimerDuration(180)" id="preset-180" class="timer-preset py-1.5 px-2 rounded-xl border border-cyan-400 bg-cyan-50 text-cyan-700 font-bold text-xs transition cursor-pointer">3:00</button>
                        <button onclick="setTimerDuration(120)" id="preset-120" class="timer-preset py-1.5 px-2 rounded-xl border border-slate-200 bg-slate-50 text-slate-600 font-bold text-xs transition cursor-pointer">2:00</button>
                        <button onclick="setTimerDuration(90)" id="preset-90" class="timer-preset py-1.5 px-2 rounded-xl border border-slate-200 bg-slate-50 text-slate-600 font-bold text-xs transition cursor-pointer">1:30</button>
                        <button onclick="setTimerDuration(60)" id="preset-60" class="timer-preset py-1.5 px-2 rounded-xl border border-slate-200 bg-slate-50 text-slate-600 font-bold text-xs transition cursor-pointer">1:00</button>
                    </div>

                    <!-- Fine Adjustment -->
                    <div class="flex items-center justify-between bg-slate-50 border border-slate-200 rounded-2xl p-2.5 mb-3">
                        <span class="text-xs font-semibold text-slate-600">Regola al secondo:</span>
                        <div class="flex items-center gap-1.5">
                            <button onclick="adjustTimer(-30)" class="w-7 h-7 bg-white border border-slate-200 rounded-lg text-xs font-bold text-cyan-700 hover:bg-slate-100 transition cursor-pointer">-30s</button>
                            <span id="timer-display-setting" class="font-display font-black text-sm text-slate-800 w-12 text-center">03:00</span>
                            <button onclick="adjustTimer(30)" class="w-7 h-7 bg-white border border-slate-200 rounded-lg text-xs font-bold text-cyan-700 hover:bg-slate-100 transition cursor-pointer">+30s</button>
                        </div>
                    </div>
                </div>

                <!-- Session Action Buttons -->
                <div class="grid grid-cols-2 gap-2 pt-2">
                    <button onclick="resetSession()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs py-2.5 px-3 rounded-2xl transition border border-slate-200 shadow-sm flex items-center justify-center gap-1 cursor-pointer">
                        🔄 Ricomincia
                    </button>
                    <button onclick="finishSessionEarly(event)" class="bg-gradient-to-r from-cyan-400 to-fuchsia-400 hover:from-cyan-500 hover:to-fuchsia-500 text-slate-950 font-bold text-xs py-2.5 px-3 rounded-2xl transition shadow-md flex items-center justify-center gap-1 cursor-pointer">
                        🏁 Concludi & Report
                    </button>
                </div>
            </div>

        </section>

        <!-- TYPING ARENA -->
        <main class="mt-1 relative flex-1 flex flex-col">
            <div id="typing-card" onclick="focusTypingInput()" 
                class="bg-white/95 backdrop-blur-xl border-2 border-cyan-300 hover:border-cyan-400 rounded-3xl p-5 sm:p-7 shadow-xl shadow-cyan-100 transition cursor-text relative overflow-hidden flex-1 flex flex-col justify-between">
                
                <!-- Card Header Bar -->
                <div class="flex flex-wrap items-center justify-between gap-2 mb-3 pb-3 border-b border-slate-100">
                    <div class="flex items-center gap-2">
                        <span id="item-counter" class="text-xs font-bold text-cyan-800 bg-cyan-100 px-3 py-1 rounded-xl border border-cyan-300">
                            Frase 1 di 5
                        </span>
                        <span id="item-translation" class="text-xs text-slate-500 italic hidden sm:inline">
                            <!-- Traduzione in italiano -->
                        </span>
                    </div>

                    <!-- Realtime Statistics -->
                    <div class="flex items-center gap-3 text-xs font-bold">
                        <div class="flex items-center gap-1 text-cyan-700 bg-cyan-50 px-2.5 py-1 rounded-xl border border-cyan-200">
                            <span>⚡</span> <span id="stat-wpm">0</span> WPM
                        </div>
                        <div class="flex items-center gap-1 text-pink-700 bg-pink-50 px-2.5 py-1 rounded-xl border border-pink-200">
                            <span>🎯</span> <span id="stat-acc">100</span>%
                        </div>
                        <div class="flex items-center gap-1 text-amber-700 bg-amber-50 px-2.5 py-1 rounded-xl border border-amber-200">
                            <span>⏱️</span> <span id="timer-countdown">03:00</span>
                        </div>
                    </div>
                </div>

                <!-- Visual Progress Bar -->
                <div class="w-full bg-slate-100 h-2 rounded-full mb-4 overflow-hidden border border-slate-200">
                    <div id="timer-bar-fill" class="bg-gradient-to-r from-cyan-400 via-fuchsia-400 to-amber-400 h-full w-full transition-all duration-300"></div>
                </div>

                <!-- TEXT DISPLAY AREA (PERMISSIVE ERROR HANDLING) -->
                <div class="my-auto py-4">
                    <div class="text-center mb-3">
                        <span id="current-title-label" class="text-xs font-extrabold uppercase tracking-wider text-cyan-800 bg-cyan-100 px-3 py-1 rounded-full border border-cyan-300">
                            Daily Routine • Morning Habits
                        </span>
                    </div>

                    <div id="text-display-area" class="font-mono text-lg sm:text-2xl md:text-3xl leading-relaxed text-center select-none tracking-wide px-2 min-h-[110px] flex items-center justify-center flex-wrap">
                        <!-- Caratteri iniettati via JS -->
                    </div>
                </div>

                <!-- Invisible Input capturing key events -->
                <input type="text" id="hidden-typing-input" class="absolute opacity-0 pointer-events-none" autocomplete="off" autocapitalize="off" spellcheck="false">

                <!-- Hint & Streak Footer -->
                <div class="text-center pt-3 border-t border-slate-100 mt-3 flex items-center justify-between text-xs text-slate-500">
                    <span id="typing-hint">💡 Clicca sulla card per iniziare. Gli errori non bloccano la digitazione!</span>
                    <span class="font-bold text-amber-600">Serie: <span id="current-streak">0</span> 🔥</span>
                </div>
            </div>

            <!-- VIRTUAL ON-SCREEN KEYBOARD -->
            <div class="mt-4 bg-white/90 backdrop-blur-xl border border-cyan-200 rounded-3xl p-3.5 sm:p-4 shadow-xl shadow-cyan-100" onclick="event.stopPropagation()">
                <div class="text-center text-[11px] font-bold text-slate-600 mb-2 uppercase tracking-wider flex items-center justify-center gap-1.5">
                    <span>⌨️ Tastiera Guida Virtuale</span>
                    <span class="text-cyan-800 bg-cyan-100 px-2 py-0.5 rounded-lg border border-cyan-300">Illumina il prossimo tasto</span>
                </div>
                
                <!-- Keyboard Layout -->
                <div class="max-w-3xl mx-auto flex flex-col gap-1.5 select-none" id="virtual-keyboard">
                    <!-- Row 1 -->
                    <div class="flex justify-center gap-1">
                        <div class="v-key w-7 sm:w-10 h-7 sm:h-9 bg-slate-100 border border-slate-300 rounded-lg flex items-center justify-center text-[10px] sm:text-xs font-bold text-slate-700 cursor-pointer" data-key="`">`</div>
                        <div class="v-key w-7 sm:w-10 h-7 sm:h-9 bg-slate-100 border border-slate-300 rounded-lg flex items-center justify-center text-[10px] sm:text-xs font-bold text-slate-700 cursor-pointer" data-key="1">1</div>
                        <div class="v-key w-7 sm:w-10 h-7 sm:h-9 bg-slate-100 border border-slate-300 rounded-lg flex items-center justify-center text-[10px] sm:text-xs font-bold text-slate-700 cursor-pointer" data-key="2">2</div>
                        <div class="v-key w-7 sm:w-10 h-7 sm:h-9 bg-slate-100 border border-slate-300 rounded-lg flex items-center justify-center text-[10px] sm:text-xs font-bold text-slate-700 cursor-pointer" data-key="3">3</div>
                        <div class="v-key w-7 sm:w-10 h-7 sm:h-9 bg-slate-100 border border-slate-300 rounded-lg flex items-center justify-center text-[10px] sm:text-xs font-bold text-slate-700 cursor-pointer" data-key="4">4</div>
                        <div class="v-key w-7 sm:w-10 h-7 sm:h-9 bg-slate-100 border border-slate-300 rounded-lg flex items-center justify-center text-[10px] sm:text-xs font-bold text-slate-700 cursor-pointer" data-key="5">5</div>
                        <div class="v-key w-7 sm:w-10 h-7 sm:h-9 bg-slate-100 border border-slate-300 rounded-lg flex items-center justify-center text-[10px] sm:text-xs font-bold text-slate-700 cursor-pointer" data-key="6">6</div>
                        <div class="v-key w-7 sm:w-10 h-7 sm:h-9 bg-slate-100 border border-slate-300 rounded-lg flex items-center justify-center text-[10px] sm:text-xs font-bold text-slate-700 cursor-pointer" data-key="7">7</div>
                        <div class="v-key w-7 sm:w-10 h-7 sm:h-9 bg-slate-100 border border-slate-300 rounded-lg flex items-center justify-center text-[10px] sm:text-xs font-bold text-slate-700 cursor-pointer" data-key="8">8</div>
                        <div class="v-key w-7 sm:w-10 h-7 sm:h-9 bg-slate-100 border border-slate-300 rounded-lg flex items-center justify-center text-[10px] sm:text-xs font-bold text-slate-700 cursor-pointer" data-key="9">9</div>
