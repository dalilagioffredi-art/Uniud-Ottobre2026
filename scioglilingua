            }

            const titles = {
                routine: "Daily Routine",
                twisters: "Scioglilingua Agility",
                chat: "Chat & Dialoghi",
                email: "Email & Diario",
                verbs: "Verbi & Frasi"
            };
            document.getElementById('active-category-badge').textContent = titles[cat] || cat;
            loadItemsForCurrentCategory();
        }

        function setDifficulty(diff) {
            state.difficulty = diff;
            ['beginner', 'intermediate', 'expert'].forEach(d => {
                const btn = document.getElementById(`diff-${d}`);
                if (d === diff) {
                    btn.className = "px-3 py-1.5 rounded-xl text-xs font-bold bg-cyan-400 text-slate-900 shadow-sm transition cursor-pointer";
                } else {
                    btn.className = "px-3 py-1.5 rounded-xl text-xs font-bold text-slate-600 hover:text-slate-900 transition cursor-pointer";
                }
            });

            if (state.autoTimer) {
                if (diff === 'beginner') setTimerDuration(180);
                else if (diff === 'intermediate') setTimerDuration(120);
                else setTimerDuration(90);
            }

            if (state.category !== 'custom' && state.category !== 'vocab') {
                loadItemsForCurrentCategory();
            }
        }

        function loadItemsForCurrentCategory() {
            if (state.category === 'custom') {
                state.items = [state.customUserText];
            } else if (state.category === 'vocab') {
                loadVocabItems();
                return;
            } else {
                const catObj = textDatabases[state.category];
                state.items = catObj ? (catObj[state.difficulty] || catObj.beginner) : [];
            }
            state.currentIndex = 0;
            initCurrentItem();
        }

        function loadVocabItems() {
            if (state.customVocabList.length === 0) {
                state.items = [
                    { en: "alarm clock wakes me up early.", it: "La sveglia mi sveglia presto." },
                    { en: "breakfast is the most important meal.", it: "La colazione è il pasto più importante." }
                ];
            } else {
                state.items = state.customVocabList.map(v => ({
                    en: `${v.word} - ${v.translation}`,
                    it: v.translation
                }));
            }
            state.currentIndex = 0;
            initCurrentItem();
        }

        function loadCustomText() {
            const titleInput = document.getElementById('custom-title-input').value.trim();
            const textInput = document.getElementById('custom-text-input').value.trim();
            if (!textInput) {
                showToast("⚠️ Attenzione", "Inserisci del testo nel riquadro prima di caricare.", "amber");
                return;
            }
            state.customUserText = {
                title: titleInput || "Custom Exercise",
                text: textInput,
                en: textInput,
                it: "Testo personalizzato"
            };
            state.items = [state.customUserText];
            state.currentIndex = 0;
            initCurrentItem();
            showToast("✨ Brano Caricato", "Il tuo testo personalizzato è pronto!", "cyan");
