        function addVocabWord() {
            const w = document.getElementById('vocab-word-input').value.trim();
            const t = document.getElementById('vocab-trans-input').value.trim();
            if (!w || !t) {
                showToast("⚠️ Campi vuoti", "Inserisci sia la parola che la traduzione.", "amber");
                return;
            }
            state.customVocabList.push({ word: w, translation: t });
            localStorage.setItem('typing_vocab_list', JSON.stringify(state.customVocabList));
            document.getElementById('vocab-word-input').value = "";
            document.getElementById('vocab-trans-input').value = "";
            renderVocabList();
            loadVocabItems();
            showToast("✅ Parola Aggiunta", `"${w}" salvata nel dizionario!`, "cyan");
        }

        function renderVocabList() {
            document.getElementById('vocab-counter').textContent = `${state.customVocabList.length} parole`;
        }

        function clearVocabList() {
            state.customVocabList = [];
            localStorage.removeItem('typing_vocab_list');
            renderVocabList();
            loadVocabItems();
            showToast("🗑️ Lista Svuotata", "Il dizionario personale è stato azzerato.", "cyan");
        }

        function toggleAutoTimer() {
            state.autoTimer = document.getElementById('auto-timer-toggle').checked;
        }

        function setTimerDuration(seconds) {
            state.timerSeconds = seconds;
            state.timeRemaining = seconds;
            document.querySelectorAll('.timer-preset').forEach(b => {
                b.className = "timer-preset py-1.5 px-2 rounded-xl border border-slate-200 bg-slate-50 text-slate-600 font-bold text-xs transition cursor-pointer";
            });
            const btnId = `preset-${seconds}`;
            const targetBtn = document.getElementById(btnId);
            if (targetBtn) {
                targetBtn.className = "timer-preset py-1.5 px-2 rounded-xl border border-cyan-400 bg-cyan-50 text-cyan-700 font-bold text-xs transition cursor-pointer";
            }
            updateTimerDisplay();
        }

        function adjustTimer(delta) {
            state.timerSeconds = Math.max(30, state.timerSeconds + delta);
            state.timeRemaining = state.timerSeconds;
            updateTimerDisplay();
        }

        function updateTimerDisplay() {
            const m = Math.floor(state.timeRemaining / 60);
            const s = state.timeRemaining % 60;
            const formatted = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
            document.getElementById('timer-countdown').textContent = formatted;
            document.getElementById('timer-display-setting').textContent = formatted;
            
            const pct = (state.timeRemaining / state.timerSeconds) * 100;
            document.getElementById('timer-bar-fill').style.width = `${pct}%`;
        }

        function startTimerIfNeeded() {
            if (!state.isRunning && !state.isFinished) {
                state.isRunning = true;
                state.timerInterval = setInterval(() => {
                    if (state.timeRemaining > 0) {
                        state.timeRemaining--;
                        updateTimerDisplay();
                        updateRealtimeStats();
                        if (state.timeRemaining === 0) {
                            finishSession();
                        }
                    }
                }, 1000);
            }
        }

        function initCurrentItem() {
            if (state.currentIndex >= state.items.length) {
                state.currentIndex = 0;
            }
            const item = state.items[state.currentIndex];
            // Normalize spaces to ensure natural separation
            state.currentText = (item.en || item.text).replace(/\s+/g, ' ');
            state.currentTranslation = item.it || "";
            state.charIndex = 0;
            state.errors = 0;
            state.errorIndices = new Set();

            document.getElementById('item-counter').textContent = `Frase ${state.currentIndex + 1} di ${state.items.length}`;
            document.getElementById('item-translation').textContent = state.currentTranslation ? `🇹🇩 ${state.currentTranslation}` : "";
            
            renderTextDisplay();
            highlightNextKey();
        }

        function renderTextDisplay() {
            const container = document.getElementById('text-display-area');
            container.innerHTML = "";

            for (let i = 0; i < state.currentText.length; i++) {
                const span = document.createElement('span');
                const char = state.currentText[i];
                
                // Make space characters clearly visible and spaced
                if (char === ' ') {
                    span.innerHTML = '&nbsp;';
                    span.className = "inline-block px-1.5 transition-all duration-75 ";
                } else {
                    span.textContent = char;
                    span.className = "transition-all duration-75 inline-block ";
                }

                if (i < state.charIndex) {
                    if (state.errorIndices && state.errorIndices.has(i)) {
                        span.className += " char-incorrect text-white px-0.5 rounded";
                    } else {
                        span.classList.add('char-correct');
                    }
                } else if (i === state.charIndex) {
                    span.classList.add('char-current');
                } else {
                    span.classList.add('text-slate-400');
                }
                container.appendChild(span);
            }
        }

        function focusTypingInput() {
            document.getElementById('hidden-typing-input').focus();
        }

        document.addEventListener('keydown', (e) => {
            if (state.isFinished) return;
            if (e.key === 'F1' || e.key === 'F5' || e.key === 'Tab' || e.key === 'Alt' || e.key === 'Control' || e.key === 'Meta') return;

            startTimerIfNeeded();
            focusTypingInput();

            const targetChar = state.currentText[state.charIndex];

            if (e.key === 'Backspace') {
                if (state.charIndex > 0) {
                    state.charIndex--;
                    if (state.errorIndices) state.errorIndices.delete(state.charIndex);
                    renderTextDisplay();
                    highlightNextKey();
                    playAudio('back');
                }
                return;
            }

            if (e.key.length === 1) {
                state.totalKeystrokes++;
                animateVirtualKey(e.key);

                if (!state.errorIndices) state.errorIndices = new Set();

                if (e.key === targetChar) {
                    state.correctChars++;
                    state.currentStreak++;
                    if (state.currentStreak > state.maxStreak) {
                        state.maxStreak = state.currentStreak;
                    }
                    playAudio('correct');
                } else {
                    state.errors++;
                    state.currentStreak = 0;
                    state.errorIndices.add(state.charIndex);
                    playAudio('error');
                }

                // Permissive error handling: always advance to next char
                state.charIndex++;

                document.getElementById('current-streak').textContent = state.currentStreak;
                renderTextDisplay();
                updateRealtimeStats();
                highlightNextKey();

                if (state.charIndex >= state.currentText.length) {
                    state.completedItems++;
                    state.bonusPoints += 25;
                    checkDailyGoals();
                    showToast("🎉 Ottimo Lavoro!", "Frase completata! +25 XP bonus", "cyan");
                    setTimeout(() => {
                        state.currentIndex++;
                        state.errorIndices = new Set();
                        initCurrentItem();
                    }, 400);
                }
            }
        });

        function updateRealtimeStats() {
            const elapsedSec = state.timerSeconds - state.timeRemaining;
            if (elapsedSec <= 0) return;
            const minutes = elapsedSec / 60;
            const wpm = Math.round((state.correctChars / 5) / minutes);
            const accuracy = state.totalKeystrokes > 0 
                ? Math.round((state.correctChars / state.totalKeystrokes) * 100) 
                : 100;

            document.getElementById('stat-wpm').textContent = wpm;
            document.getElementById('stat-acc').textContent = accuracy;
            checkDailyGoals();
        }

        function checkDailyGoals() {
            const elapsedSec = getElapsedSeconds();
            const minutes = elapsedSec / 60;
            const wpm = Math.round((state.correctChars / 5) / minutes);
            const accuracy = state.totalKeystrokes > 0 ? Math.round((state.correctChars / state.totalKeystrokes) * 100) : 100;

            // Goal 1: WPM >= 25
            const g1 = document.getElementById('goal-1');
            if (wpm >= 25) {
                g1.classList.remove('bg-slate-50', 'border-slate-200');
                g1.classList.add('bg-emerald-50', 'border-emerald-300');
                document.getElementById('goal-1-icon').textContent = '✅';
            }

            // Goal 2: Accuracy >= 90
            const g2 = document.getElementById('goal-2');
            if (accuracy >= 90 && state.totalKeystrokes >= 10) {
                g2.classList.remove('bg-slate-50', 'border-slate-200');
                g2.classList.add('bg-emerald-50', 'border-emerald-300');
                document.getElementById('goal-2-icon').textContent = '✅';
            }

            // Goal 3: Completed >= 2
            const g3 = document.getElementById('goal-3');
            if (state.completedItems >= 2) {
                g3.classList.remove('bg-slate-50', 'border-slate-200');
                g3.classList.add('bg-emerald-50', 'border-emerald-300');
                document.getElementById('goal-3-icon').textContent = '✅';
            }
        }

        function getElapsedSeconds() {
            return Math.max(1, state.timerSeconds - state.timeRemaining);
        }

        function setupKeyboardVisualizer() {
            document.querySelectorAll('.v-key').forEach(keyEl => {
                keyEl.addEventListener('click', (ev) => {
                    ev.stopPropagation();
                    const keyValue = keyEl.getAttribute('data-key');
                    simulateKeyPress(keyValue);
                });
            });
        }

        function highlightNextKey() {
            document.querySelectorAll('.v-key').forEach(k => k.classList.remove('active-target'));
            
            if (state.charIndex < state.currentText.length) {
                const nextChar = state.currentText[state.charIndex].toLowerCase();
                document.querySelectorAll('.v-key').forEach(k => {
                    if (k.getAttribute('data-key') && k.getAttribute('data-key').toLowerCase() === nextChar) {
                        k.classList.add('active-target');
                    }
                });
                if (nextChar === ' ') {
                    const spaceKey = document.querySelector('[data-key=" "]');
                    if (spaceKey) spaceKey.classList.add('active-target');
                }
            }
        }

        function animateVirtualKey(char) {
            const lower = char.toLowerCase();
            document.querySelectorAll('.v-key').forEach(k => {
                if (k.getAttribute('data-key') && k.getAttribute('data-key').toLowerCase() === lower) {
                    k.classList.add('pressed');
                    setTimeout(() => k.classList.remove('pressed'), 120);
                }
            });
        }

        function toggleAudio() {
            state.audioEnabled = !state.audioEnabled;
            const btn = document.getElementById('audio-toggle-btn');
            btn.innerHTML = state.audioEnabled ? "🔊 <span class='hidden sm:inline'>Audio</span>" : "🔇 <span class='hidden sm:inline'>Muto</span>";
            showToast(state.audioEnabled ? "🔊 Audio Attivato" : "🔇 Audio Disattivato", "", "cyan");
        }

        function playAudio(type) {
            if (!state.audioEnabled) return;
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.connect(gain);
                gain.connect(ctx.destination);

                if (type === 'correct') {
                    osc.frequency.setValueAtTime(580, ctx.currentTime);
                    osc.frequency.exponentialRampToValueAtTime(880, ctx.currentTime + 0.08);
                    gain.gain.setValueAtTime(0.04, ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.08);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.08);
                } else if (type === 'error') {
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(180, ctx.currentTime);
                    osc.frequency.exponentialRampToValueAtTime(120, ctx.currentTime + 0.12);
                    gain.gain.setValueAtTime(0.06, ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.12);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.12);
                } else if (type === 'back') {
                    osc.frequency.setValueAtTime(320, ctx.currentTime);
                    gain.gain.setValueAtTime(0.03, ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.05);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.05);
                }
            } catch (e) {}
        }

        function simulateKeyPress(keyValue) {
            if (state.isFinished) return;
            startTimerIfNeeded();
            
            const targetChar = state.currentText[state.charIndex];
            state.totalKeystrokes++;

            if (keyValue.toLowerCase() === targetChar.toLowerCase()) {
                state.correctChars++;
                state.currentStreak++;
                if (state.currentStreak > state.maxStreak) state.maxStreak = state.currentStreak;
                playAudio('correct');
            } else {
                state.errors++;
                state.currentStreak = 0;
                if (!state.errorIndices) state.errorIndices = new Set();
                state.errorIndices.add(state.charIndex);
                playAudio('error');
            }

            state.charIndex++;

            document.getElementById('current-streak').textContent = state.currentStreak;
            renderTextDisplay();
            updateRealtimeStats();
            highlightNextKey();

            if (state.charIndex >= state.currentText.length) {
                state.completedItems++;
                state.bonusPoints += 25;
                showToast("🎉 Ottimo Lavoro!", "Frase completata! +25 XP bonus", "cyan");
                setTimeout(() => {
                    state.currentIndex++;
                    state.errorIndices = new Set();
                    initCurrentItem();
                }, 400);
            }
        }

        function finishSessionEarly(e) {
            if (e) e.stopPropagation();
            if (state.totalKeystrokes === 0) {
                showToast("ℹ️ Nessun dato", "Digita almeno qualche parola prima di generare il report!", "cyan");
                return;
            }
            finishSession();
        }

        function finishSession() {
            clearInterval(state.timerInterval);
            state.isRunning = false;
            state.isFinished = true;

            const elapsedSec = getElapsedSeconds();
            const minutes = elapsedSec / 60;
            const wpm = Math.round((state.correctChars / 5) / minutes);
            const accuracy = state.totalKeystrokes > 0
                ? Math.round((state.correctChars / state.totalKeystrokes) * 100)
                : 100;

            let gradeComment = "Valutazione: Buon inizio! Continua ad allenarti.";
            if (wpm >= 45 && accuracy >= 97) {
                gradeComment = "Valutazione: Campione Assoluto (10/10 e Lode) • Velocità e perfezione sbalorditive!";
            } else if (wpm >= 38 && accuracy >= 95) {
                gradeComment = "Valutazione: Eccellente (10/10) • Padronanza da professionista!";
            } else if (wpm >= 30 && accuracy >= 90) {
                gradeComment = "Valutazione: Ottimo (9/10) • Ottima fluidità in inglese!";
            } else if (wpm >= 22 && accuracy >= 85) {
                gradeComment = "Valutazione: Distinto (8/10) • Ritmo costante!";
            } else if (wpm >= 12) {
                gradeComment = "Valutazione: Buono (7/10) • Stai prendendo molta confidenza!";
            }

            const badges = [];
            if (state.category === 'twisters') {
                badges.push({ icon: "🌀", title: "Lingua di Fuoco", desc: "Superato l'allenamento scioglilingua!", pts: 180 });
            }
            if (wpm >= 45) {
                badges.push({ icon: "⚡", title: "Supersonico", desc: "Superati i 45 WPM!", pts: 250 });
            } else if (wpm >= 35) {
                badges.push({ icon: "🚀", title: "Fulmine della Tastiera", desc: "Superati i 35 WPM!", pts: 150 });
            } else if (wpm >= 22) {
                badges.push({ icon: "💨", title: "Velocista Mattiniero", desc: "Ritmo superiore a 22 WPM!", pts: 80 });
            }

            if (accuracy === 100 && state.totalKeystrokes >= 30) {
                badges.push({ icon: "👑", title: "Perfezione Assoluta", desc: "100% di precisione senza errori!", pts: 300 });
            } else if (accuracy >= 98 && state.totalKeystrokes >= 20) {
                badges.push({ icon: "🎯", title: "Precisione Chirurgica", desc: "Accuratezza superiore al 98%!", pts: 120 });
            } else if (accuracy >= 90 && state.totalKeystrokes >= 15) {
                badges.push({ icon: "💎", title: "Mano Ferma", desc: "Precisione superiore al 90%!", pts: 60 });
            }

            if (state.maxStreak >= 75) {
                badges.push({ icon: "💥", title: "Leggenda della Combo", desc: `Serie incredibile di ${state.maxStreak} tasti!`, pts: 200 });
            } else if (state.maxStreak >= 40) {
                badges.push({ icon: "🔥", title: "Combo Master", desc: `Serie consecutiva di ${state.maxStreak} tasti!`, pts: 100 });
            }

            if (state.completedItems >= 5) {
                badges.push({ icon: "📚", title: "Maratoneta dell'Inglese", desc: `${state.completedItems} esercizi completati!`, pts: 150 });
            } else if (state.completedItems >= 2) {
                badges.push({ icon: "🌟", title: "Costanza di Studio", desc: `${state.completedItems} contenuti completati!`, pts: 90 });
            }

            if (badges.length === 0) {
                badges.push({ icon: "🌱", title: "Primo Passo", desc: "Sessione completata con successo!", pts: 50 });
            }

            state.earnedBadges = badges;
            const badgePointsTotal = badges.reduce((acc, b) => acc + b.pts, 0);
            const totalScore = (state.correctChars * 2) + state.bonusPoints + badgePointsTotal;

            state.finalMetrics = { wpm, accuracy, elapsedSec, totalScore, gradeComment };

            document.getElementById('result-grade-comment').textContent = gradeComment;
            document.getElementById('final-wpm').textContent = `${wpm} WPM`;
            document.getElementById('final-accuracy').textContent = `${accuracy}%`;
            document.getElementById('final-streak').textContent = state.maxStreak;
            document.getElementById('final-score').textContent = `${totalScore} XP`;
            document.getElementById('badges-count').textContent = badges.length;

            document.getElementById('badges-container').innerHTML = badges.map(b => `
                <div class="flex items-center gap-2.5 bg-slate-50 border border-slate-200 rounded-2xl p-2.5 shadow-sm">
                    <span class="text-2xl">${b.icon}</span>
                    <div class="flex-1 min-w-0">
                        <div class="font-display font-bold text-xs sm:text-sm text-slate-800 truncate">${b.title}</div>
                        <div class="text-[11px] text-slate-500 truncate">${b.desc}</div>
                    </div>
                    <span class="text-xs font-bold text-cyan-700 bg-cyan-100 px-2 py-0.5 rounded-lg border border-cyan-300">+${b.pts} XP</span>
                </div>
            `).join('');

            document.getElementById('results-modal').classList.remove('hidden');
            launchConfetti();
        }

        function closeModalAndRestart() {
            document.getElementById('results-modal').classList.add('hidden');
            resetSession();
        }

        function resetSession() {
            clearInterval(state.timerInterval);
            state.isRunning = false;
            state.isFinished = false;
            state.timeRemaining = state.timerSeconds;
            state.charIndex = 0;
            state.errors = 0;
            state.correctChars = 0;
            state.totalKeystrokes = 0;
            state.currentStreak = 0;
            state.maxStreak = 0;
            state.completedItems = 0;
            state.bonusPoints = 0;
            state.errorIndices = new Set();
            
            updateTimerDisplay();
            initCurrentItem();
            document.getElementById('stat-wpm').textContent = '0';
            document.getElementById('stat-acc').textContent = '100';
            document.getElementById('current-streak').textContent = '0';
            focusTypingInput();
        }

        function downloadReportHTML() {
