        function updateStudentData() {
            saveStudentData();
        }

        function setCategory(cat) {
            state.category = cat;
            document.querySelectorAll('.cat-btn').forEach(b => {
                b.classList.remove('border-cyan-400', 'bg-cyan-50', 'text-slate-800');
                b.classList.add('border-slate-200', 'bg-slate-50', 'text-slate-600');
            });
            const activeBtn = document.getElementById(`cat-${cat}`);
            if (activeBtn) {
                activeBtn.classList.remove('border-slate-200', 'text-slate-600');
                activeBtn.classList.add('border-cyan-400', 'bg-cyan-50', 'text-slate-800');
            }

            const customPanel = document.getElementById('dynamic-input-panel');
            const customBox = document.getElementById('custom-text-box');
            const vocabBox = document.getElementById('vocab-list-box');

            customBox.classList.add('hidden');
            vocabBox.classList.add('hidden');
            customPanel.classList.add('hidden');

            if (cat === 'custom') {
                customPanel.classList.remove('hidden');
                customBox.classList.remove('hidden');
                document.getElementById('active-category-badge').textContent = "Incolla Testo";
                return;
            }

